    "login": "node --env-file-if-exists=../../.env src/login.ts",
    "harvest": "node --env-file-if-exists=../../.env src/harvest-surveys.ts"
  },
  "dependencies": {
    "@cosme/contract": "*",
    "@cosme/core": "*",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
